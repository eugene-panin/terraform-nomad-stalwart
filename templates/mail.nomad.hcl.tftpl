job "${job_name}" {
  namespace   = "${namespace}"
  datacenters = ${jsonencode(datacenters)}
  type        = "service"

  meta {
    config_version = "${config_version}"
    backup         = "stop"
  }

  group "mail" {
    network {
      mode = "bridge"

      port "smtp" {
        static       = 25
        to           = 25
        host_network = "${public_host_network}"
      }

      port "submissions" {
        static       = 465
        to           = 465
        host_network = "${public_host_network}"
      }

      port "submission" {
        static       = 587
        to           = 587
        host_network = "${public_host_network}"
      }

      port "imaps" {
        static       = 993
        to           = 993
        host_network = "${public_host_network}"
      }

      port "https" {
        to           = 8443
        host_network = "${internal_network}"
      }
    }

    volume "data" {
      type            = "host"
      source          = "${volume_name}"
      access_mode     = "single-node-writer"
      attachment_mode = "file-system"
    }

    service {
      name     = "${job_name}"
      port     = "https"
      provider = "consul"
      tags = [
        "traefik.enable=true",
        "traefik.tcp.routers.${job_name}.rule=${join(" || ", [for n in tls_names : "HostSNI(`${n}`)"])}",
        "traefik.tcp.routers.${job_name}.entrypoints=${traefik.entrypoint}",
        "traefik.tcp.routers.${job_name}.tls.passthrough=true",
        "traefik.tcp.services.${job_name}.loadbalancer.serverstransport=${traefik.servers_transport}",
      ]

      check {
        type     = "tcp"
        interval = "10s"
        timeout  = "2s"
      }
    }

    task "setup" {
      driver = "docker"
      user   = "65534:65534"

      lifecycle {
        hook    = "prestart"
        sidecar = false
      }

      artifact {
        source      = "https://github.com/stalwartlabs/cli/releases/download/v${stalwart.cli}/stalwart-cli-$${attr.kernel.arch}-unknown-linux-musl.tar.xz"
        destination = "local/cli"

        options {
          checksum = "file:https://github.com/stalwartlabs/cli/releases/download/v${stalwart.cli}/sha256.sum"
        }
      }

      config {
        image           = "${stalwart.image}"
        entrypoint      = ["/bin/sh"]
        args            = ["/local/setup.sh"]
        readonly_rootfs = true
        cap_drop        = ["all"]
        cap_add         = ["net_bind_service"]

        healthchecks {
          disable = true
        }

        mount {
          type   = "tmpfs"
          target = "/tmp"

          tmpfs_options {
            size = 268435456
          }
        }
      }

      volume_mount {
        volume      = "data"
        destination = "/data"
      }

      vault {}

      env {
        HOME   = "/local"
        TMPDIR = "/local"
%{ if acme_ca_certificate != null ~}
        SSL_CERT_FILE = "/alloc/ca.pem"
%{ endif ~}
      }

%{ if acme_ca_certificate != null ~}
      template {
        destination     = "local/acme-ca.pem"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
${acme_ca_certificate}
        EOT
      }

%{ endif ~}
      template {
        destination     = "local/config.json"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
          {"@type":"RocksDb","path":"/data"}
        EOT
      }

      template {
        destination = "secrets/recovery.env"
        env         = true
        data        = <<-EOT
          {{ with secret "${secret_path}" }}STALWART_RECOVERY_ADMIN=admin:{{ .Data.data.recovery_password }}
          STALWART_PASSWORD={{ .Data.data.recovery_password }}{{ end }}
        EOT
      }

      template {
        destination = "secrets/plan.ndjson"
        data        = <<-EOT
          {{ with secret "${secret_path}" }}{{ .Data.data.plan }}{{ end }}
          {"@type":"upsert","object":"NetworkListener","matchOn":["name"],"value":{"smtp":{"name":"smtp","protocol":"smtp","bind":{"0.0.0.0:25":true}},"submissions":{"name":"submissions","protocol":"smtp","bind":{"0.0.0.0:465":true},"useTls":true,"tlsImplicit":true},"submission":{"name":"submission","protocol":"smtp","bind":{"0.0.0.0:587":true}},"imaps":{"name":"imaps","protocol":"imap","bind":{"0.0.0.0:993":true},"useTls":true,"tlsImplicit":true},"https":{"name":"https","protocol":"http","bind":{"0.0.0.0:8443":true},"useTls":true,"tlsImplicit":true,"overrideProxyTrustedNetworks":{"{{ env "NOMAD_HOST_IP_https" }}/32":true}}}}
        EOT
      }

      template {
        destination     = "local/setup.sh"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
          set -eu
          arch=$(uname -m)
%{ if acme_ca_certificate != null ~}
          cat /etc/ssl/certs/ca-certificates.crt /local/acme-ca.pem > /alloc/ca.pem
%{ endif ~}
          STALWART_RECOVERY_MODE=1 STALWART_RECOVERY_MODE_PORT=8081 /usr/local/bin/stalwart --config /local/config.json &
          server=$!
          trap 'kill "$server" 2>/dev/null || true' EXIT
          export STALWART_URL="http://127.0.0.1:8081" STALWART_USER=admin
          cli="/local/cli/stalwart-cli-$arch-unknown-linux-musl/stalwart-cli"
          tries=0
          until "$cli" describe >/local/describe.log 2>&1; do
            kill -0 "$server"
            tries=$((tries + 1))
            [ "$tries" -lt 60 ] || { cat /local/describe.log >&2; echo "the recovery server did not answer" >&2; exit 1; }
            sleep 1
          done
          "$cli" --no-color apply --file /secrets/plan.ndjson
          kill "$server"
          wait "$server" || true
        EOT
      }

      resources {
        cpu    = 200
        memory = 512
      }
    }

    task "stalwart" {
      driver = "docker"
      user   = "65534:65534"

      config {
        image           = "${stalwart.image}"
        args            = ["--config", "/local/config.json"]
        readonly_rootfs = true
        cap_drop        = ["all"]
        cap_add         = ["net_bind_service"]

        healthchecks {
          disable = true
        }

        mount {
          type   = "tmpfs"
          target = "/tmp"

          tmpfs_options {
            size = 268435456
          }
        }
      }

      volume_mount {
        volume      = "data"
        destination = "/data"
      }

      env {
        HOME   = "/local"
        TMPDIR = "/local"
%{ if acme_ca_certificate != null ~}
        SSL_CERT_FILE = "/alloc/ca.pem"
%{ endif ~}
      }

      template {
        destination     = "local/config.json"
        left_delimiter  = "[["
        right_delimiter = "]]"
        data            = <<-EOT
          {"@type":"RocksDb","path":"/data"}
        EOT
      }

      resources {
        cpu    = 500
        memory = 1024
      }
    }
  }
}
